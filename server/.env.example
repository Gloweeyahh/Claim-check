PORT=5000

# Set this to your deployed Netlify URL in production (e.g. https://claimcheck.netlify.app)
# so only your own frontend can call this API. Leave blank for local dev.
FRONTEND_URL=

# Create at https://console.cloud.google.com — enable "YouTube Data API v3",
# create an API key. No OAuth needed for public video snippet/comment reads.
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Create at https://console.anthropic.com — used for claim analysis and the
# final plain-language assessment. Any Claude model works; sonnet gives the
# best reasoning quality, haiku is cheaper for heavy dev/testing use.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — raises PubMed's rate limit from 3 to 10 requests/sec.
# Get one free at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Powers the WHO/CDC evidence search via Google's Programmable Search Engine
# (https://programmablesearchengine.google.com — free tier, 100 queries/day).
# Create a search engine set to "search the entire web", copy its Search
# engine ID as GOOGLE_CSE_ID, and get a matching key at
# https://console.cloud.google.com (enable "Custom Search API").
# Without these, verify still works — it just won't have WHO/CDC results,
# only PubMed.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Powers logging each check (claim, verdict, source) for later analysis.
# Project already created — see the values below. Get SUPABASE_SERVICE_ROLE_KEY
# from your Supabase dashboard: Project Settings → API → "service_role" secret.
# NEVER put this key in the client/.env — it must only live on the server.
# Without these two, verify still works — it just won't log anything.
SUPABASE_URL=https://ocuyrjmjlmvlyjtxhxix.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
